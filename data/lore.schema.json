{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/lore.schema.json",
  "title": "Lore text (doc 11 s5, s6): masthead, intro line, road sign, notes, archive clippings, campaign win lines",
  "type": "object",
  "additionalProperties": false,
  "required": ["table", "schema_version", "records"],
  "properties": {
    "table": {"const": "lore"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "properties": {
          "id": {"enum": ["masthead", "intro", "road_sign", "notes", "archive", "win"]},
          "source": {"enum": ["doc01", "sim", "placeholder"]},
          "cite": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "notice": {"type": "string"},
          "at": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "notice_y": {"type": "number"},
          "title_y": {"type": "number"},
          "post_top": {"type": "number"},
          "post_half": {"type": "number"},
          "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "notes": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "anchor", "offset", "text"],
              "properties": {
                "id": {"type": "string"},
                "anchor": {"type": "string"},
                "offset": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                "child": {"type": "boolean"},
                "facing": {"type": "number"},
                "width": {"type": "number"},
                "mount": {"enum": ["wall", "post"]},
                "text": {"type": "string", "minLength": 1}
              }
            }
          },
          "clippings": {
            "type": "array",
            "minItems": 21,
            "maxItems": 21,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["head", "text"],
              "properties": {"head": {"type": "string"}, "text": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
