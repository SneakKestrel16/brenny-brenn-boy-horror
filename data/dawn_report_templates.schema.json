{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/dawn_report_templates.schema.json",
  "title": "Dawn Report templates (doc 03 section 17)",
  "type": "object",
  "additionalProperties": false,
  "required": ["table", "schema_version", "records"],
  "properties": {
    "table": {"const": "dawn_report_templates"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"$ref": "#/$defs/source"},
          "cite": {"type": "string"},
          "sources": {"$ref": "#/$defs/sources"},
          "section": {"enum": ["headline", "replay", "obituary", "hero_action", "flags", "ledger", "season_award"]},
          "text": {"type": "string", "minLength": 1}
        },
        "required": ["id", "source", "section", "text"]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "source": {"enum": ["doc01", "sim", "placeholder"]},
    "sources": {"type": "object", "additionalProperties": {"enum": ["doc01", "sim", "placeholder"]}}
  }
}
