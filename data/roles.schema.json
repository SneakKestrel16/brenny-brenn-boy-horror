{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/roles.schema.json",
  "title": "Roles (doc 02 section 15)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "schema_version",
    "records"
  ],
  "properties": {
    "table": {
      "const": "roles"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "farmer",
              "rancher",
              "mechanic",
              "tracker",
              "carpenter",
              "medic",
              "night_owl",
              "radio_operator",
              "warden",
              "medium",
              "crowkeeper"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "cite": {
            "type": "string"
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "name": {
            "type": "string"
          },
          "perks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "required": [
          "id",
          "source",
          "name",
          "perks"
        ]
      },
      "maxItems": 11,
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "farmer"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "rancher"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "mechanic"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "tracker"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "carpenter"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "medic"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "night_owl"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "radio_operator"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "warden"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "medium"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source": {
      "enum": [
        "doc01",
        "sim",
        "placeholder"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "doc01",
          "sim",
          "placeholder"
        ]
      }
    }
  }
}
