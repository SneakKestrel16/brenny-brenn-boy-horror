{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/creature.schema.json",
  "title": "Creature (doc 03 sections 2-4, proposed in P1-01)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "schema_version",
    "records"
  ],
  "properties": {
    "table": {
      "const": "creature"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "body"
              },
              "signature_sound": {
                "type": "string"
              },
              "quirk": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "signature_sound",
              "quirk"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "speed"
              },
              "speed_mps": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "speed_mps"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "timer"
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "seconds"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "distance"
              },
              "metres": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "metres"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "mult"
              },
              "mult": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "mult"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "cite": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "kind": {
                "const": "noise"
              },
              "radius_m": {
                "type": "number",
                "minimum": 0
              },
              "exponent": {
                "type": "number",
                "minimum": 0
              },
              "byte_max": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "source",
              "kind",
              "radius_m"
            ]
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "body_gaunt"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "body_scarecrow"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "body_boar"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "body_husk"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "chase_speed_mps"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "lurk_speed_mps"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "stalk_speed_mps"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "noise_step_walk"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "noise_voice"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source": {
      "enum": [
        "doc01",
        "sim",
        "placeholder"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "doc01",
          "sim",
          "placeholder"
        ]
      }
    }
  }
}
