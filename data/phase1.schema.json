{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/phase1.schema.json",
  "title": "DD Phase 1 scripted timers (doc 03 section 18, proposed in P1-01)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "schema_version",
    "records"
  ],
  "properties": {
    "table": {
      "const": "phase1"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "cite": {
            "type": "string"
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "metres": {
            "type": "number",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "percent": {
            "type": "number",
            "minimum": 0
          },
          "flag": {
            "type": "boolean"
          },
          "seconds_list": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "source"
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "night_s"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "trap_set_at_s"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "scripted_lurk_s"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source": {
      "enum": [
        "doc01",
        "sim",
        "placeholder"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "doc01",
          "sim",
          "placeholder"
        ]
      }
    }
  }
}
