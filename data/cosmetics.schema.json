{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/cosmetics.schema.json",
  "title": "Cosmetic store (doc 02 section 21.5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["table", "schema_version", "records"],
  "properties": {
    "table": {"const": "cosmetics"},
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "cite"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"$ref": "#/$defs/source"},
          "cite": {"type": "string", "minLength": 1},
          "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "source": {"enum": ["doc01", "sim", "placeholder"]}
  }
}
