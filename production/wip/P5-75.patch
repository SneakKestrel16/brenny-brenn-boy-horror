diff --git a/tests/creature/test_p5_75.gd b/tests/creature/test_p5_75.gd
new file mode 100644
index 0000000..c62ffde
--- /dev/null
+++ b/tests/creature/test_p5_75.gd
@@ -0,0 +1,94 @@
+extends SceneTree
+## P5-75 (D-190) on a live host: the Harvest Moon act 3 `gate_run` chase runs at ai_director.json
+## profile_harvest_moon `gate_run_chase_speed_mps` (4.5); any other chase, here a forced one in act 3, keeps
+## creature.json `chase_speed_mps` (5.5). Before P5-75 both measured 5.5, so the first check fails on the old code.
+##   "$GODOT" --headless --audio-driver Dummy --path . -s res://tests/creature/test_p5_75.gd -- --host --port=51075 --free-mouse
+## Exits 0 on pass, 1 on any failure.
+
+var _fails := 0
+var _frames := 0
+var _ev: Array = []  # [name, data] from Log.logged
+var Game: Node
+var cr: Node
+var farm: Node
+var cart: Node
+
+
+func _initialize() -> void:
+	change_scene_to_file.call_deferred("res://game/core/boot.tscn")
+
+
+func _process(_d: float) -> bool:
+	_frames += 1
+	if _frames == 60:
+		_run()
+	return false
+
+
+func _check(ok: bool, what: String) -> void:
+	print("  %s %s" % ["ok  " if ok else "FAIL", what])
+	if not ok:
+		_fails += 1
+
+
+## Horizontal metres per game second the creature covers over `s` seconds while the player pushes.
+func _speed(s: float) -> float:
+	var at: Vector3 = cr.global_position
+	var t := 0.0
+	var walked := 0.0
+	while t < s:
+		await physics_frame
+		Game.players[1].pos = cart.handle_pos()
+		t += 1.0 / Engine.physics_ticks_per_second
+		walked += Vector2(cr.global_position.x - at.x, cr.global_position.z - at.z).length()
+		at = cr.global_position
+	return walked / s
+
+
+func _run() -> void:
+	Game = root.get_node("Game")
+	var data := root.get_node("Data")
+	var main := root.get_node("Main")
+	cr = main.get_node("Creature")
+	farm = main.get_node("Farm")
+	cart = farm.cart
+	root.get_node("Log").logged.connect(func(n: StringName, d: Dictionary) -> void: _ev.append([String(n), d]))
+	var dev: Node
+	for c in main.get_children():
+		if c.get_script() and c.get_script().resource_path.ends_with("dev_console.gd"):
+			dev = c
+	_check(dev != null and cr._ok, "dev console and a host creature")
+	if dev == null or not cr._ok:
+		quit(1)
+		return
+	var gate_mps := float(data.value(&"ai_director", &"profile_harvest_moon", &"gate_run_chase_speed_mps"))
+	var chase_mps := float(data.value(&"creature", &"chase_speed_mps", &"speed_mps"))
+	Game.players[1].freeze_until = Time.get_ticks_msec() + 3600000
+	root.get_node("Clock").day = int(data.value(&"season", &"season_days"))
+	dev.run("phase harvest_moon")
+	cart.act = cart.PUSH
+	cart.offset = cart.length - 25.0  # inside the last gate_run_m 30: the next frame starts act 3
+	cart._place()
+	main.get_node("Generator").damage()
+	Game.players[1].pos = cart.handle_pos()
+	farm.registry.request(1, &"push_cart", "cart")
+	cr.global_position = cart.pos_at(cart.offset - 18.0)  # on the route behind the cart: open road
+	cr.force_state(&"lurk", &"test", 0)
+	var t := 0.0
+	while t < 10.0 and cr.state != &"chase":
+		await physics_frame
+		Game.players[1].pos = cart.handle_pos()
+		t += 1.0 / Engine.physics_ticks_per_second
+	var why: Array = _ev.filter(func(e: Array) -> bool: return e[0] == "chase_started").map(func(e: Array) -> String: return e[1].reason)
+	_check(cart.act == cart.GATE_RUN and why.has("gate_run"), "act 3 gate_run chase started (act %d, chases %s, %.1f s)" % [cart.act, why, t])
+	var v: float = await _speed(1.0)
+	_check(absf(v - gate_mps) < 0.3, "gate_run chase speed %.2f m/s, want %.1f" % [v, gate_mps])
+	# Any other chase keeps chase_speed_mps: force one from behind the cart again.
+	cr.force_state(&"lurk", &"test", 0)
+	cr.global_position = cart.pos_at(cart.offset - 18.0)
+	cr.force_state(&"chase", &"test", 1)
+	v = await _speed(1.0)
+	_check(cr.state == &"chase" and absf(v - chase_mps) < 0.3, "other act 3 chase speed %.2f m/s, want %.1f" % [v, chase_mps])
+	farm.registry.cancel(1)
+	print("test_p5_75: ", "FAIL %d" % _fails if _fails else "PASS")
+	quit(1 if _fails else 0)
