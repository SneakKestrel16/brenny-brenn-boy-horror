--- /dev/null
+++ b/tests/creature/test_p5_73.gd
@@ -0,0 +1,321 @@
+extends SceneTree
+## P5-73 creature pathing checks, on frozen bots:
+##   A, the pen and the props: `_way_to` knows the pen (its gate is its door) and the well; a lurk goal inside the pen
+##      is reached through the gate, and one at the well's centre (where a well_pump noise sits) is reached, no stuck.
+##   B, P5-72 stuck recovery per state, on a temporary wall `_way_to` does not know: chase, stalk, retreat and a lurk
+##      search each log creature_stuck, recover (the search keeps searching) and stuck at most 4 times in 20 s (no
+##      endless swing along the wall); the side step pointing into the lit barn never enters it.
+##   C, as designed, not dynamic: the scripted stalk (doc 03 s18) walks at the true position, takes no hiding spot,
+##      holds at scripted_standoff_m and backs off when the target comes closer.
+##   D, as designed: the Harvest Moon act 2 stalk on a pusher (knock not ready) walks straight and holds 10 m off
+##      (doc 03 s14), no stuck while it holds; act 3 chases straight.
+##   "$GODOT" --headless --audio-driver Dummy --path . -s res://tests/creature/test_p5_73.gd -- --host --bots=3 --port=46730 --free-mouse
+## Exits 0 on pass, 1 on any failure.
+
+var _fails := 0
+var _frames := 0
+var _ev: Array = []
+var Game: Node
+var main: Node
+var cr: Node
+var v := 0
+
+
+func _initialize() -> void:
+	change_scene_to_file.call_deferred("res://game/core/boot.tscn")
+
+
+func _process(_d: float) -> bool:
+	_frames += 1
+	if _frames == 60:
+		_run()
+	return false
+
+
+func _check(ok: bool, what: String) -> void:
+	print("  %s %s" % ["ok  " if ok else "FAIL", what])
+	if not ok:
+		_fails += 1
+
+
+func _wait(s: float) -> void:
+	var t := 0.0
+	while t < s:
+		await physics_frame
+		t += 1.0 / Engine.physics_ticks_per_second
+
+
+func _flat(p: Vector3) -> Vector2:
+	return Vector2(p.x, p.z)
+
+
+func _stucks() -> Array:
+	return _ev.filter(func(e: Array) -> bool: return e[0] == "creature_stuck")
+
+
+## A 0.3 m thick, 2.5 m tall wall `w` metres wide, centred on `at`, across the line from `from`.
+func _wall(at: Vector3, from: Vector3, w: float) -> StaticBody3D:
+	var b := StaticBody3D.new()
+	var s := CollisionShape3D.new()
+	var box := BoxShape3D.new()
+	box.size = Vector3(w, 2.5, 0.3)
+	s.shape = box
+	b.add_child(s)
+	main.get_node("World").add_child(b)
+	b.global_position = Vector3(at.x, 1.25, at.z)
+	b.rotation.y = atan2(at.x - from.x, at.z - from.z)  # local z along the walk: the wall's width across it
+	return b
+
+
+## Runs `secs` (or until `done`), calling `feed` each frame; returns [stuck count, moved after the first stuck, first
+## stuck position]. Moved is the farthest the creature got from where it first got stuck.
+func _push(secs: float, feed: Callable, done: Callable, after_stuck: Callable) -> Array:
+	_ev.clear()
+	var first := Vector3.INF
+	var moved := 0.0
+	var t := 0.0
+	while t < secs and not done.call():
+		feed.call()
+		await physics_frame
+		t += 1.0 / Engine.physics_ticks_per_second
+		if first == Vector3.INF and not _stucks().is_empty():
+			first = cr.global_position
+			after_stuck.call()
+		if first != Vector3.INF:
+			moved = maxf(moved, cr.global_position.distance_to(first))
+	return [_stucks().size(), moved, first]
+
+
+func _run() -> void:
+	Game = root.get_node("Game")
+	main = root.get_node("Main")
+	cr = main.get_node("Creature")
+	root.get_node("Log").logged.connect(func(n: StringName, d: Dictionary) -> void: _ev.append([String(n), d]))
+	var dir: Node = main.get_node("AiDirector")
+	var gen: Node = main.get_node("Generator")
+	var ids: Array = Game.players.keys()
+	for p: int in ids:
+		Game.players[p].freeze_until = Time.get_ticks_msec() + 3600000
+		Game.players[p].pos = Vector3(-60, 0, -60) + Vector3(p % 7, 0, 0)
+	for b in main.get_node("Bots").get_children():
+		b.process_mode = Node.PROCESS_MODE_DISABLED
+	var dev: Node
+	for c in main.get_children():
+		if c.get_script() and c.get_script().resource_path.ends_with("dev_console.gd"):
+			dev = c
+	dev.run("day 2")
+	await _wait(1.0)
+	dev.run("phase night")
+	await _wait(0.5)
+	gen.damage()
+	cr._scripted = false
+	cr._set_state(&"lurk", &"dev", 0)
+	v = ids[0]
+	var nothing := func() -> void: pass
+	var never := func() -> bool: return false
+
+	print("A: the pen and the well are in the way-finding")
+	var pen := Rect2()
+	var gate := Vector2.INF
+	var well := false
+	for i in cr._walls.size():
+		if cr._wall_doors[i] != Vector2.INF:
+			pen = cr._walls[i]
+			gate = cr._wall_doors[i]
+		well = well or cr._walls[i].has_point(Vector2(49, -20))
+	_check(pen.has_point(Vector2(-24, -33)) and pen.has_point(Vector2(-29.5, -37.5)) and not pen.has_point(Vector2(-24, -39)),
+		"the pen footprint %s from the level's fence" % pen)
+	_check(gate.distance_to(Vector2(-24, -28)) < 0.1 and well, "its gate %s is its door; the well is a wall too (%s)" % [gate, well])
+	var inside := Vector3(-24, 0, -33)
+	cr.global_position = Vector3(-24, 0, -41)  # north of the north fence: the gate is on the far side
+	cr._memory.clear()
+	cr._goal = inside
+	var via := [INF]
+	var r: Array = await _push(30.0, func() -> void: via[0] = minf(via[0], _flat(cr.global_position).distance_to(gate)),
+		func() -> bool: return cr._goal == Vector3.INF, nothing)
+	_check(r[0] == 0 and cr._goal == Vector3.INF and cr.global_position.distance_to(inside) <= cr.ARRIVE_M + 0.5,
+		"a lurk goal inside the pen is reached, %d stuck, ends %.1f m off" % [r[0], cr.global_position.distance_to(inside)])
+	_check(via[0] < 1.5, "in through the gate: %.1f m from it at closest" % via[0])
+	var wc := Vector3(49, 0, -20)
+	cr.global_position = Vector3(49, 0, -28)
+	cr._goal = wc
+	r = await _push(15.0, nothing, func() -> bool: return cr._goal != wc, nothing)
+	_check(r[0] == 0 and cr._goal != wc and cr.global_position.distance_to(wc) < 3.0,  # arrival: within ARRIVE_M of the padded edge
+		"a lurk goal at the well's centre (a well_pump noise) is reached at its side, %d stuck, %.1f m off" % [r[0], cr.global_position.distance_to(wc)])
+
+	print("B: stuck recovery per state, on a wall `_way_to` does not know")
+	var from := Vector3(30, 0, -48)
+	var to := Vector3(30, 0, -32)
+	var w := _wall(Vector3(30, 0, -40), from, 10.0)
