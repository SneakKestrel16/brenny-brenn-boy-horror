// sfx_step_dirt_06 (placeholder, P4-26). One footstep on dirt, mono, 3D, 0.35 s. Generated by tools/audio/gen_steps.py,
// doc 08 section 11.2. Heel and toe noise thuds, a scuff and dry soil grains (filtered Dust); no oscillator.
(
var toe, heel, tone, roll, grit, gd, extra;
thisThread.randSeed = 2616;
toe = rrand(0.06, 0.12); heel = rrand(0.75, 1.0); tone = rrand(0.85, 1.18); roll = rrand(0.35, 0.65);
grit = rrand(0.6, 1.0); gd = rrand(1400, 2600); extra = rrand(0.7, 1.0);
(
	channels: 1,
	duration: 0.35,
	defs: [
		SynthDef(\step, { |out = 0|
			var hEnv = EnvGen.ar(Env.perc(0.002, 0.07, curve: -6));
			var wEnv = EnvGen.ar(Env.perc(0.004, 0.11, curve: -5));
			var tEnv = EnvGen.ar(Env([0, 0, 1, 0], [toe, 0.003, 0.06], [0, 0, -6]));
			var sEnv = EnvGen.ar(Env([0, 0, 1, 0], [toe * 0.4, toe * 0.5, 0.05], [0, 2, -4]));
			var thud = LPF.ar(LPF.ar(WhiteNoise.ar, 320 * tone), 320 * tone) * hEnv * heel * 2.5;
			var weight = LPF.ar(BrownNoise.ar, 140 * tone) * wEnv * heel * 1.6;
			var toeHit = LPF.ar(BPF.ar(WhiteNoise.ar, 650 * tone, 1.4), 1800) * tEnv * roll * 1.2;
			var scuff = BPF.ar(PinkNoise.ar, 1300 * tone, 1.2) * sEnv * 0.35;
			var cEnv = EnvGen.ar(Env([0, 1, 0.35, 0.9, 0], [0.004, toe, 0.004, 0.11], -4));
			var grains = Decay2.ar(Dust.ar(gd), 0.0002, 0.0025) * WhiteNoise.ar;
			var crunch = LPF.ar(BPF.ar(grains, 2200 * tone, 1.6), 4500) * cEnv * grit * 0.9;
			Out.ar(out, thud + weight + toeHit + scuff + crunch);
		})
	],
	events: [[0, [\s_new, \step, -1, 0, 0]]]
)
)
